# AgroShield Pro — Ortam Değişkenleri Şablonu
# Hassas API anahtarları kesinlikle ön yüz (frontend) koduna gömülmemelidir.

PORT=4000
NODE_ENV=development

# Veritabanı ve Zaman Serisi Telemetri Bağlantısı (PostgreSQL / TimescaleDB)
DATABASE_URL=postgresql://agro_user:CHANGE_ME@localhost:5432/agroshield_db

# Saha Kontrol Direkleri MQTT Broker Bağlantısı (TLS Zorunlu)
MQTT_BROKER_URL=mqtts://broker.agroshield.local:8883
MQTT_USERNAME=pole_gateway_service
MQTT_PASSWORD=CHANGE_ME

# JWT ve Rol Tabanlı Yetkilendirme (RBAC)
JWT_SECRET=CHANGE_THIS_TO_A_64_BYTE_RANDOM_SECRET
JWT_EXPIRES_IN=8h

# Coğrafi Harita Servisi Yapılandırması (İsteğe Bağlı Özel Karo Sunucusu)
MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_API_KEY=

# Fiziksel Donanım ve Acil Durdurma (E-Stop) Güvenlik Anahtarı
HARDWARE_INTERLOCK_ENABLED=true
HARDWARE_MTLS_CERT_PATH=/etc/agroshield/certs/gateway.pem
